{
  "name": "@effect-app-boilerplate/api",
  "version": "0.0.1",
  "main": "./src/main.ts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "circular": "madge --circular --ts-config ./tsconfig.json --extensions ts ./src",
    "clean": "rm -rf dist test/dist",
    "build": "pnpm paths:gen && NODE_OPTIONS=--max-old-space-size=8192 node ../scripts/tsgo-or-tsc.ts --build --stopBuildOnErrors",
    "watch": "pnpm build --watch",
    "watch2": "NODE_OPTIONS=--max-old-space-size=8192 node ../scripts/tsgo-or-tsc.ts -w",
    "check": "pnpm paths:gen && NODE_OPTIONS=--max-old-space-size=8192 node ../scripts/tsgo-or-tsc.ts --build --stopBuildOnErrors",
    "lint:oxlint": "oxlint --quiet --type-aware src test",
    "lint:oxlint:fix": "oxlint --quiet --type-aware --fix src test",
    "format": "dprint fmt --config ../dprint.jsonc .",
    "format:check": "dprint check --config ../dprint.jsonc .",
    "lint": "pnpm lint:oxlint && pnpm format:check",
    "lint-fix": "pnpm lint:oxlint:fix && pnpm format",
    "test": "vitest",
    "test:run": "pnpm run test run --passWithNoTests",
    "testsuite": "pnpm circular && pnpm run test:run && pnpm lint",
    "dev": "NODE_ENV=development nodemon --signal SIGTERM --exec node ./src/main.ts",
    "start": "node ./src/main.ts",
    "debug": "node --inspect ./src/main.ts",
    "ncu": "ncu",
    "extract:i18n": "formatjs extract './**/*.ts' --ignore './**/*.d.ts' --format src/i18n/extraction-formatter.cjs --id-interpolation-pattern '[sha512:contenthash:base64:6]' --out-file src/i18n/extracted/en.json",
    "paths:gen": "node ../scripts/generate-tsconfig-paths.ts",
    "paths:check": "node ../scripts/generate-tsconfig-paths.ts --check"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "imports": {
    "#api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "#config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "#core/*": {
      "types": "./src/core/*.ts",
      "default": "./src/core/*.ts"
    },
    "#models": {
      "types": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "#models/*": {
      "types": "./src/models/*.ts",
      "default": "./src/models/*.ts"
    },
    "#resources/*": {
      "types": "./src/resources/*.ts",
      "default": "./src/resources/*.ts"
    },
    "#services/*": {
      "types": "./src/services/*.ts",
      "default": "./src/services/*.ts"
    }
  },
  "dependencies": {
    "@azure/arm-monitor": "^7.0.0",
    "@azure/cosmos": "^4.9.3",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.31.0",
    "@effect-app/infra": "4.0.0-beta.332",
    "effect-app": "4.0.0-beta.332",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-sqlite-node": "^4.0.0",
    "@effect/vitest": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@formatjs/cli": "^6.16.6",
    "@formatjs/intl": "^4.1.12",
    "@mollie/api-client": "^4.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.55.0",
    "@sentry/opentelemetry": "^10.55.0",
    "connect": "^3.7.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "effect": "^4.0.0",
    "express": "^5.2.1",
    "express-compression": "^1.0.2",
    "express-oauth2-jwt-bearer": "^1.9.0",
    "fast-check": "~4.9.0",
    "jwks-rsa": "2.1.4",
    "jwt-decode": "^4.0.0",
    "object-hash": "^3.0.0",
    "papaparse": "^5.5.3",
    "redis": "^3.1.2",
    "redlock": "^5.0.0-beta.2",
    "redoc": "^2.5.3",
    "redoc-express": "^2.1.3",
    "stopwatch-node": "^1.1.0",
    "swagger-ui-express": "^5.0.1",
    "tcp-port-used": "^1.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/redis": "^2.8.32",
    "@types/swagger-ui-express": "^4.1.8",
    "dprint": "^0.54.0",
    "typescript": "6.0.3"
  }
}
