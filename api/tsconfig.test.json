{
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "rootDir": "./test",
    "outDir": "./test/dist",
    "tsBuildInfoFile": "./test/dist/.tsbuildinfo",
    "paths": {
      "#api": [
        "./src/api.ts"
      ],
      "#config": [
        "./src/config.ts"
      ],
      "#lib/*": [
        "./src/lib/*.ts"
      ],
      "#core/*": [
        "./src/core/*.ts"
      ],
      "#models": [
        "./src/models.ts"
      ],
      "#models/*": [
        "./src/models/*.ts"
      ],
      "#resources/*": [
        "./src/resources/*.ts"
      ],
      "#services/*": [
        "./src/services/*.ts"
      ]
    }
  },
  "include": [
    "./test/**/*.ts"
  ],
  "exclude": [
    "./dist",
    "./test/dist",
    "node_modules",
    "build",
    "lib",
    "dist",
    "**/*.d.ts.map",
    ".git",
    ".data",
    "**/.*",
    "**/*.tmp"
  ],
  "references": [
    {
      "path": "./tsconfig.src.json"
    }
  ]
}
