{
  "compilerOptions": {
    "paths": {
      "#config": [
        "./src/config.js"
      ],
      "#config/*": [
        "./src/config/*.js"
      ],
      "#core/*": [
        "./src/core/*.js"
      ],
      "#lib/*": [
        "./src/lib/*.js"
      ],
      "#models": [
        "./src/models.js"
      ],
      "#models/*": [
        "./src/models/*.js"
      ],
      "#resources/*": [
        "./src/resources/*.js"
      ],
      "#services/*": [
        "./src/services/*.js"
      ]
    }
  },
  "extends": "../tsconfig.base.json",
  "references": [
    {
      "path": "./tsconfig.src.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
