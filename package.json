{
  "name": "@effect-app-boilerplate/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "pnpm": ">= 11.0.0",
    "node": ">= 24.14"
  },
  "compilerPatches": {
    "tsgoRepo": "effect-app/tsgo",
    "tsgoReleaseTag": "latest"
  },
  "scripts": {
    "all": "pnpm -r",
    "preinstall": "npx only-allow pnpm",
    "clean": "pnpm all run clean",
    "dev.log": "tail -f api/.logs/*.log | humanlog --keep requestId --keep requestName --truncate-length 16384",
    "lint-fix": "NODE_OPTIONS=--max-old-space-size=8192 pnpm lint-fix-api && pnpm lint-fix-frontend && pnpm lint-fix-e2e",
    "lint": "pnpm lint-api && pnpm lint-frontend && pnpm lint-e2e",
    "start": "concurrently -k -p \"[{name}]\" -n \"API,Frontend\" -c \"cyan.bold,green.bold,blue.bold\" \"pnpm start:api\" \"pnpm start:frontend\"",
    "start:api": "cd api && pnpm start",
    "start:frontend": "cd frontend && pnpm start",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Watch,API,Frontend\" -c \"yellow.bold,cyan.bold,green.bold\" \"pnpm watch\" \"pnpm dev:api\" \"pnpm dev:frontend\"",
    "dev:api": "cd api && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "build-apps": "cd api && pnpm build && cd ../frontend && pnpm build",
    "test": "pnpm all --filter '!./e2e' test",
    "testsuite": "pnpm all testsuite",
    "up-all": "pnpm --recursive update",
    "u": "pnpm run update && pnpm i && pnpm dedupe",
    "update": "ncu -u && pnpm -r ncu -u",
    "ncu": "ncu",
    "ncu:filters": "bash -c 'for filter in \"$@\"; do ncu -u --filter \"$filter\" && pnpm -r ncu -u --filter \"$filter\"; done' --",
    "ncu:effect": "pnpm ncu:filters \"effect\" \"@effect/*\" \"@effect/atom*\" && pnpm ncu:effect-app",
    "ncu:effect-app": "pnpm ncu:filters \"effect-app\" \"@effect-app/*\" && pnpm i",
    "subtree:effect": "pnpm effa sync-effect",
    "embedded:effect:link": "node scripts/embedded-effect-source.ts link",
    "embedded:effect:unlink": "node scripts/embedded-effect-source.ts unlink",
    "embedded:effect:status": "node scripts/embedded-effect-source.ts status",
    "embedded:effect:check-unlinked": "node scripts/embedded-effect-source.ts check-unlinked",
    "embedded:effect:build-vue-components": "node scripts/embedded-effect-source.ts build-vue-components",
    "apps": "pnpm all --workspace-concurrency 1",
    "api": "pnpm all --workspace-concurrency 1 --filter \"./api\"",
    "circular-api": "pnpm api circular",
    "lint-api": "cd api && pnpm lint",
    "lint-fix-api": "cd api && pnpm lint-fix",
    "l": "effect-app link",
    "ul": "effect-app unlink",
    "lint-e2e": "cd e2e && pnpm lint",
    "lint-fix-e2e": "cd e2e && pnpm lint-fix",
    "lint-frontend": "cd frontend && pnpm lint",
    "lint-fix-frontend": "cd frontend && pnpm lint-fix",
    "check:int": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/tsgo-or-tsc.ts --build --stopBuildOnErrors",
    "build:int": "pnpm check:int",
    "paths:gen": "node scripts/generate-tsconfig-paths.ts",
    "paths:check": "node scripts/generate-tsconfig-paths.ts --check",
    "check": "pnpm check:int ./tsconfig.all.json && cd frontend && pnpm check",
    "build": "pnpm build:int ./tsconfig.all.json && cd frontend && pnpm build",
    "watch": "pnpm build:int ./tsconfig.all.json --watch",
    "watch-src": "pnpm build:int ./tsconfig.src.json --watch",
    "build-prod": "pnpm build-frontend-prod",
    "build-frontend-prod": "cd frontend && pnpm build",
    "rbuild": "pnpm clean && pnpm check",
    "nnm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm i",
    "restart-api": "cd api && touch .env.local",
    "prepare": "node scripts/install-patched-compilers.ts && node scripts/install-git-hooks.ts",
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "test:scripts": "node --test --experimental-strip-types scripts/lib/changes.test.ts",
    "validate:changed": "node scripts/validate-changed.ts",
    "validate:plan": "node scripts/validate-changed.ts --plan",
    "pr:ready": "node scripts/agent-pr-ready.ts"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "^4.0.0",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "comment-json": "^5.0.0",
    "date-fns": "^4.4.0",
    "effect": "^4.0.0",
    "fast-check": "~4.9.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.38",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@effect-app/cli": "^2.1.0-beta.43",
    "@effect-app/eslint-codegen-model": "^2.0.0-beta.27",
    "@effect-app/eslint-shared-config": "^0.6.0-beta.35",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "0.36.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "~25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "concurrently": "^10.0.1",
    "dprint": "^0.54.0",
    "effect-app": "4.0.0-beta.332",
    "lint-staged": "^17.1.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^22.2.1",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "ts-plugin-prefer-namespace-import": "workspace:*",
    "typescript": "6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.0.15",
    "vitest": "^4.1.7"
  }
}
