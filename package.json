{
  "name": "@effect-app-boilerplate/root",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "eslint-plugin-vue": "10.9.0",
      "eslint-plugin-vuetify>eslint-plugin-vue": "10.9.0"
    },
    "patchedDependencies": {
      "typescript": "patches/typescript.patch",
      "ts-plugin-sort-import-suggestions": "patches/ts-plugin-sort-import-suggestions.patch",
      "@tanstack/query-core": "patches/@tanstack__query-core.patch"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf",
      "@sentry/cli",
      "core-js",
      "dprint",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "engines": {
    "pnpm": ">= 10.2.1"
  },
  "scripts": {
    "all": "pnpm -r",
    "preinstall": "npx only-allow pnpm",
    "clean": "pnpm all clean",
    "clean-dist": "pnpm all clean-dist",
    "lint-fix": "NODE_OPTIONS=--max-old-space-size=8192 pnpm lint-fix-api && pnpm lint-fix-frontend && pnpm lint-fix-e2e",
    "lint": "pnpm lint-api && pnpm lint-frontend && pnpm lint-e2e",
    "lint-fix-api": "cd api && pnpm lint-fix",
    "lint-fix-e2e": "cd e2e && pnpm lint-fix",
    "lint-fix-frontend": "cd frontend && pnpm lint-fix",
    "circular:dist": "pnpm all circular:dist",
    "start": "concurrently -k -p \"[{name}]\" -n \"API,Frontend\" -c \"cyan.bold,green.bold,blue.bold\" \"pnpm start:api\" \"pnpm start:frontend\"",
    "start:api": "cd api && pnpm start",
    "start:frontend": "cd frontend && pnpm start",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Watch,API,Frontend\" -c \"yellow.bold,cyan.bold,green.bold\" \"pnpm watch\" \"pnpm dev:api\" \"pnpm dev:frontend\"",
    "dev:api": "cd api && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "build-apps": "cd api && pnpm build && cd ../frontend && pnpm build",
    "test": "pnpm all test",
    "testsuite": "pnpm all testsuite",
    "up-all": "pnpm --recursive update",
    "u": "pnpm run update && pnpm i && pnpm dedupe",
    "update": "ncu -u && pnpm -r ncu -u",
    "ncu": "ncu",
    "ncu:filters": "bash -c 'for filter in \"$@\"; do ncu -u --filter \"$filter\" && pnpm -r ncu -u --filter \"$filter\"; done' --",
    "ncu:effect": "pnpm ncu:filters \"effect\" \"@effect/*\" \"@effect-atom/*\" && pnpm ncu:effect-app",
    "ncu:effect-app": "pnpm ncu:filters \"effect-app\" \"@effect-app/*\" && pnpm i",
    "build-libs": "cd libs && pnpm build && cd ../.. && pnpm build",
    "apps": "pnpm all --workspace-concurrency 1",
    "api": "pnpm all --workspace-concurrency 1 --filter \"./api\"",
    "lint-api": "cd api && pnpm lint",
    "lint-e2e": "cd e2e && pnpm lint",
    "lint-frontend": "cd frontend && pnpm lint",
    "check:tsc": "NODE_OPTIONS=--max-old-space-size=8192 tsc --build",
    "build:tsc": "NODE_OPTIONS=--max-old-space-size=8192 effect-app-cli index-multi pnpm check:tsc",
    "check": "pnpm check:tsc ./tsconfig.all.json && cd frontend && pnpm check",
    "build": "pnpm build:tsc ./tsconfig.all.json && cd frontend && pnpm build",
    "watch": "pnpm build:tsc ./tsconfig.all.json --watch",
    "watch-src": "pnpm build:tsc ./tsconfig.src.json --watch",
    "build-prod": "pnpm packages build && pnpm build-frontend-prod",
    "build-frontend-prod": "cd frontend && pnpm build",
    "rbuild": "pnpm clean && pnpm build",
    "nnm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm i",
    "prepare": "if [ \"$SKIP_PREPARE\" != \"true\" ]; then effect-language-service patch; fi"
  },
  "resolutions": {
    "@opentelemetry/api": "$@opentelemetry/api",
    "@opentelemetry/exporter-metrics-otlp-http": "$@opentelemetry/exporter-metrics-otlp-http",
    "@opentelemetry/exporter-trace-otlp-http": "$@opentelemetry/exporter-trace-otlp-http",
    "@opentelemetry/resources": "$@opentelemetry/resources",
    "@opentelemetry/sdk-logs": "$@opentelemetry/sdk-logs",
    "@opentelemetry/sdk-metrics": "$@opentelemetry/sdk-metrics",
    "@opentelemetry/sdk-trace-base": "$@opentelemetry/sdk-trace-base",
    "@opentelemetry/sdk-trace-node": "$@opentelemetry/sdk-trace-node",
    "@opentelemetry/sdk-trace-web": "$@opentelemetry/sdk-trace-web",
    "@opentelemetry/semantic-conventions": "$@opentelemetry/semantic-conventions",
    "date-fns": "$date-fns",
    "effect": "$effect",
    "@effect/opentelemetry": "$@effect/opentelemetry",
    "@effect/platform-node": "$@effect/platform-node",
    "fast-check": "$fast-check",
    "vue": "$vue"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-beta.64",
    "@effect/platform-node": "4.0.0-beta.64",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.216.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.216.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "effect": "4.0.0-beta.64",
    "fast-check": "^4.7.0",
    "package-up": "^5.0.0",
    "patch-package": "^8.0.1",
    "vite-node": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@effect-app/cli": "2.1.0-beta.21",
    "@effect-app/eslint-codegen-model": "2.0.0-beta.17",
    "@effect-app/eslint-shared-config": "0.6.0-beta.25",
    "@effect/language-service": "^0.85.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/lodash": "^4.17.24",
    "@types/node": "~25.6.0",
    "concurrently": "^9.2.1",
    "dprint": "^0.54.0",
    "effect-app": "4.0.0-beta.218",
    "enhanced-resolve": "^5.21.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^22.1.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "prebuild-install": "^7.1.3",
    "ts-plugin-sort-import-suggestions": "^1.0.4",
    "ts-toolbelt": "^9.6.0",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}