{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "extends": ["./node_modules/@effect-app/eslint-shared-config/src/dprint.jsonc"],
  // excludes overwrites (not merges) the base — all standard patterns must be repeated here.
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/dist/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/coverage/**",
    "**/auto-imports.d.ts",
    "repos/**",
    "patches/**",
    "**/*.wsdl",
    "**/*.xsd",
  ],
}
