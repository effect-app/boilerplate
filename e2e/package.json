{
  "name": "@effect-app-boilerplate/e2e",
  "version": "1.0.0",
  "license": "NONE",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:watch": "playwright-watch test",
    "build": "node ../scripts/tsgo-or-tsc.ts --build tsconfig.json --stopBuildOnErrors",
    "check": "node ../scripts/tsgo-or-tsc.ts --build tsconfig.json --stopBuildOnErrors",
    "lint:oxlint": "oxlint --quiet --type-aware .",
    "lint:oxlint:fix": "oxlint --quiet --type-aware --fix .",
    "format": "dprint fmt --config ../dprint.jsonc .",
    "format:check": "dprint check --config ../dprint.jsonc .",
    "lint": "pnpm lint:oxlint && pnpm format:check",
    "lint-fix": "pnpm lint:oxlint:fix && pnpm format",
    "up": "pnpm run update && pnpm exec-update",
    "update": "pnpm ncu -u",
    "exec-update": "pnpm i",
    "clean": "rm -rf test-out",
    "ncu": "ncu",
    "watch": "pnpm build --watch"
  },
  "devDependencies": {
    "@playwright/test": "~1.60.0",
    "@types/node": "~25.9.1",
    "npm-check-updates": "^22.2.1",
    "playwright": "1.60.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@effect-app-boilerplate/api": "workspace:*",
    "@effect-app/vue": "4.0.0-beta.332",
    "@effect/platform-node": "^4.0.0",
    "effect": "^4.0.0",
    "effect-app": "4.0.0-beta.332",
    "playwright-watch": "^1.3.23"
  }
}
