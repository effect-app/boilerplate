{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./test-out",
    "lib": [
      "ES2023",
      "DOM",
      "dom.iterable"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "e2e/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ],
    // helps performance
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "./test-out"
  ],
  "references": [
    {
      "path": "../api"
    }
  ]
}
